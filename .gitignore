# ==============================================================================
# CommitCV .gitignore
# Prevents committing secrets, dependencies, build artifacts, and OS files
# ==============================================================================

# Dependencies
node_modules/
*/node_modules/

# Secrets & Environment Configurations
.env
.env.local
.env.*.local
server/.env
*.env

# Production Build Outputs
dist/
dist-ssr/
client/dist/
build/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# IDE & OS Files
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo

# Temporary cache
.cache/
.temp/
.tmp/
